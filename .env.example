# URL of the Laravel API, reachable from the Next.js server (no trailing slash)
BACKEND_URL=http://localhost:8010

# Public URL of this site — used for canonical links, sitemap.xml and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional social profiles shown in the footer (leave empty to hide)
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
